<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/first">

    <fragment
        android:id="@+id/first"
        android:name="com.example.boombee.First"
        android:label="home"
        tools:layout="@layout/fragment_first" >
        <action
            android:id="@+id/action_first_to_second"
            app:destination="@id/second" />
        <action
            android:id="@+id/action_first_to_settings"
            app:destination="@id/settings" />
        <action
            android:id="@+id/action_first_to_historyTraining"
            app:destination="@id/historyTraining" />
        <action
            android:id="@+id/action_first_to_tutorial"
            app:destination="@id/tutorial" />
    </fragment>
    <fragment
        android:id="@+id/learn"
        android:name="com.example.boombee.learn.LearnFragment"
        android:label="learn"
        tools:layout="@layout/fragment_learn">
        <action
            android:id="@+id/action_learn_to_tutorial"
            app:destination="@id/tutorial" />
    </fragment>
    <fragment
        android:id="@+id/second"
        android:name="com.example.boombee.Second"
        android:label="round"
        tools:layout="@layout/fragment_second" >
        <action
            android:id="@+id/action_second_to_first"
            app:destination="@id/first"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_second_to_rest"
            app:destination="@id/rest" />
        <action
            android:id="@+id/action_second_to_dialog"
            app:destination="@id/dialog" />
    </fragment>
    <fragment
        android:id="@+id/rest"
        android:name="com.example.boombee.Rest"
        android:label="rest"
        tools:layout="@layout/fragment_rest">
        <action
            android:id="@+id/action_rest_to_second"
            app:destination="@id/second" />
        <action
            android:id="@+id/action_rest_to_first"
            app:destination="@id/first"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/settings"
        android:name="com.example.boombee.Settings"
        android:label="settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_first"
            app:destination="@id/first" />
        <action
            android:id="@+id/action_settings_to_tutorial"
            app:destination="@id/tutorial" />
    </fragment>
    <fragment
        android:id="@+id/tutorial"
        android:name="com.example.boombee.tutorial.TutorialFragment"
        android:label="tutorial"
        tools:layout="@layout/fragment_tutorial">
        <argument
            android:name="source"
            app:argType="string"
            android:defaultValue="menu" />
        <argument
            android:name="chapter"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_tutorial_to_second"
            app:destination="@id/second"
            app:popUpTo="@id/tutorial"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/historyTraining"
        android:name="com.example.boombee.HistoryTraining"
        android:label="history" >
        <action
            android:id="@+id/action_historyTraining_to_first"
            app:destination="@id/first" />
        <action
            android:id="@+id/action_historyTraining_to_sessionDetail"
            app:destination="@id/sessionDetail" />
    </fragment>
    <fragment
        android:id="@+id/sessionDetail"
        android:name="com.example.boombee.history.SessionDetailFragment"
        android:label="session_detail"
        tools:layout="@layout/fragment_session_detail">
        <argument
            android:name="trainingId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/dialog"
        android:name="com.example.boombee.Dialog"
        android:label="stop_dialog" >
        <action
            android:id="@+id/action_dialog_to_first"
            app:destination="@id/first"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>